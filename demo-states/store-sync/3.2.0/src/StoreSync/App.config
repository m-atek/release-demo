<?xml version="1.0" encoding="utf-8"?>
<!--
  Installed as StoreSync.exe.config next to the exe, one copy per version.
  The store's own settings live one folder up, in C:\StoreSync\store.config,
  so they stay in place when a new version is installed next to the old one.
-->
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings file="..\store.config" />
</configuration>
