    "list": []
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "store-sync",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 101,
      "type": "stat",
      "title": "Wave progress",
      "description": "The wave running now, or where the last upgrade stopped, and how many store servers run the new version.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 3
      },
      "timeFrom": "14d",
      "hideTimeOverride": true,
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "expr": "{source=\"release-demo\", service=\"store-sync\", environment=\"production\", kind=\"fleet\"} | json | type=\"wave\" | line_format \"{{.label}}\"",
          "queryType": "range",
          "maxLines": 1,
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "expr": "{source=\"release-demo\", service=\"store-sync\", environment=\"production\", kind=\"fleet\"} | json | type=\"wave\" | line_format \"{{.progress}}\"",
          "queryType": "range",
          "maxLines": 1,
          "editorMode": "code"
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "Line"
              ]
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "noValue": "No upgrade yet",
          "mappings": [
            {
              "type": "regex",
              "options": {
                "pattern": ".*stopped$",
                "result": {
                  "color": "orange"
                }
              }
            },
            {
              "type": "regex",
              "options": {
                "pattern": ".*running$",
                "result": {
                  "color": "blue"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/"
        },
        "text": {
          "valueSize": 40
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "vertical",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
