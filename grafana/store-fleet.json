{
  "uid": "release-demo-store-fleet",
  "title": "Store fleet",
  "description": "store-sync on the store servers: each server's version and its status in the upgrade, refreshed every 10 seconds.",
  "tags": [
    "release-demo",
    "store-sync"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 0,
  "refresh": "10s",
  "schemaVersion": 41,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "timepicker": {},
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "links": [],
