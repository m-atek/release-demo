#!/bin/bash
# First boot only: clone the repository and install the service that runs
# scripts/demos/argocd/host/boot.sh from it on every start, as the tools host does.
set -euxo pipefail

mkdir -p /etc/release-demo
cat > /etc/release-demo/cluster-host.env <<'EOF'
REPOSITORY_URL=${repository_url}
REPO_DIR=/opt/release-demo
EOF

apt-get update -q
apt-get install -y -q git
git clone --depth 50 ${repository_url} /opt/release-demo

cat > /etc/systemd/system/release-demo-cluster-boot.service <<'EOF'
[Unit]
Description=release-demo cluster host: pull the repository and run its boot script
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/release-demo/cluster-host.env
# "-": if GitHub can't be reached, boot from the code already here.
ExecStartPre=-/usr/bin/git -C /opt/release-demo pull --ff-only
ExecStart=/opt/release-demo/scripts/demos/argocd/host/boot.sh
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now release-demo-cluster-boot.service
