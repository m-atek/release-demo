<?xml version="1.0" encoding="UTF-8"?>
<!-- Servlet 4.0 for Tomcat 9. metadata-complete: no annotation scan, so Tomcat starts faster. -->
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0" metadata-complete="true">
  <display-name>inventory</display-name>

  <listener>
    <listener-class>demo.inventory.Servlets$Startup</listener-class>
  </listener>

  <servlet>
    <servlet-name>health</servlet-name>
    <servlet-class>demo.inventory.Servlets$Health</servlet-class>
    <load-on-startup>1</load-on-startup>
  </servlet>
  <servlet>
    <servlet-name>items</servlet-name>
    <servlet-class>demo.inventory.Servlets$Items</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>home</servlet-name>
    <servlet-class>demo.inventory.Servlets$Home</servlet-class>
  </servlet>

  <servlet-mapping>
    <servlet-name>health</servlet-name>
    <url-pattern>/health</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>items</servlet-name>
    <url-pattern>/api/items/*</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>home</servlet-name>
    <url-pattern>/</url-pattern>
  </servlet-mapping>
</web-app>
