<!-- Shared by every project. The pipeline passes the version from VERSION: -p:Version=1.7.0 -->
<Project>
  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">0.0.0</Version>
    <Company>Expeditious Software</Company>
    <Product>Store Assistant</Product>
    <Copyright>Expeditious Software. Demo system, not a client's.</Copyright>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
