<Window x:Class="StoreAssistant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Store Assistant" Width="760" Height="680" FontFamily="Segoe UI">
  <DockPanel Margin="32">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Store Assistant" FontSize="22" Foreground="Gray" />
      <TextBlock x:Name="VersionText" FontSize="96" FontWeight="Bold" />
      <TextBlock x:Name="SummaryText" FontSize="26" Margin="0,8,0,16" />
      <TextBlock Text="Today's orders" FontSize="20" FontWeight="SemiBold" />
    </StackPanel>
    <TextBlock DockPanel.Dock="Bottom" Text="Demo system, not a client's." Foreground="Gray" Margin="0,12,0,0" />
    <ListView x:Name="OrdersList" FontSize="18">
      <ListView.View>
        <GridView>
          <GridViewColumn Header="Order" DisplayMemberBinding="{Binding Id}" Width="130" />
          <GridViewColumn Header="Store" DisplayMemberBinding="{Binding Store}" Width="220" />
          <GridViewColumn Header="Total" DisplayMemberBinding="{Binding Total}" Width="120" />
          <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="110" />
        </GridView>
      </ListView.View>
    </ListView>
  </DockPanel>
</Window>
