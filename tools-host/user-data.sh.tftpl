#!/bin/bash
# First boot only: record where things are, clone the repository, and install
# the service that runs tools-host/boot.sh from it on every start.
set -euxo pipefail

mkdir -p /etc/release-demo
cat > /etc/release-demo/host.env <<'EOF'
DATA_VOLUME_ID=${data_volume_id}
REPOSITORY_URL=${repository_url}
REPO_DIR=/opt/release-demo
EOF

apt-get update -q
apt-get install -y -q git
git clone --depth 50 ${repository_url} /opt/release-demo

cat > /etc/systemd/system/release-demo-boot.service <<'EOF'
[Unit]
Description=release-demo tools host: pull the repository and run tools-host/boot.sh
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/release-demo/host.env
# "-": if GitHub can't be reached, boot from the code already here.
ExecStartPre=-/usr/bin/git -C /opt/release-demo pull --ff-only
ExecStart=/opt/release-demo/tools-host/boot.sh
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now release-demo-boot.service
